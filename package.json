{
  "name": "phone-workbench",
  "version": "0.0.0",
  "private": true,
  "description": "Windows 11 and Android collaboration with a desktop UI and MCP tools. Early read-only scaffold.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/contracts",
    "packages/device-bridge",
    "packages/core",
    "packages/mcp-server",
    "apps/desktop"
  ],
  "scripts": {
    "check:workspace": "node scripts/verify-workspace.mjs",
    "typecheck": "tsc --noEmit",
    "test:modules": "npm run test --workspaces --if-present",
    "build:desktop": "npm run build --workspace @phone-workbench/desktop",
    "start:desktop": "npm run start --workspace @phone-workbench/desktop --",
    "test:acceptance": "node tests/acceptance/R1-A/run.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "esbuild": "0.28.2",
    "electron": "45.2.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugu225/phone-workbench.git"
  },
  "homepage": "https://github.com/bugu225/phone-workbench#readme",
  "bugs": {
    "url": "https://github.com/bugu225/phone-workbench/issues"
  }
}
